/*
 * version.rc - PE version info resource
 */
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SBIE_UNLOCKER_VERSION_NUM
 PRODUCTVERSION SBIE_UNLOCKER_VERSION_NUM
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",   "Sandboxie-Plus Unlocker"
            VALUE "FileVersion",       SBIE_UNLOCKER_VERSION
            VALUE "InternalName",      "version_hook"
            VALUE "OriginalFilename",  "version.dll"
            VALUE "ProductName",       "Sandboxie-Plus Unlocker"
            VALUE "ProductVersion",    SBIE_UNLOCKER_VERSION
            VALUE "CompanyName",       SBIE_UNLOCKER_AUTHOR
            VALUE "LegalCopyright",    SBIE_UNLOCKER_AUTHOR
            VALUE "Comments",          "Kernel certificate unlock for Sandboxie-Plus"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
